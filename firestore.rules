rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Só o professor dono da sessão (ownerUid) passa neste teste.
    function isOwner(sid) {
      return signedIn() &&
        get(/databases/$(database)/documents/sessions/$(sid)).data.ownerUid == request.auth.uid;
    }

    match /sessions/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Identidade da máquina: criada uma vez pelo próprio aluno; o IP não muda depois.
      match /hosts/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        // Dados de rede (pc, ip, mask, gateway, subnetIndex, hostname): o aluno não muda os próprios;
        // só o dono da sessão (professor) muda, e só esses campos.
        allow update: if signedIn() && (
          (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['pc', 'ip', 'mask', 'gateway', 'subnetIndex', 'hostname']))
          || (isOwner(sid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pc', 'ip', 'mask', 'gateway', 'subnetIndex', 'hostname']))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      // Batimento (lastSeen). Fica separado de hosts para não gastar leituras da turma inteira.
      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      match /sites/{siteName} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner(sid));
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.fromIp ==
            get(/databases/$(database)/documents/sessions/$(sid)/hosts/$(request.auth.uid)).data.ip;
        allow update: if false;
        // Delete só para o professor, para o botão "Encerrar sessão" limpar tudo.
        allow delete: if isOwner(sid);
      }

      match /answers/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(sid));
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      // Placar do Desafio da máscara: cada aluno escreve só o próprio documento.
      // ok nunca maior que total; só o professor (ownerUid) zera o ranking.
      match /scores/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.ok is int && request.resource.data.total is int
          && request.resource.data.streak is int
          && request.resource.data.ok >= 0
          && request.resource.data.ok <= request.resource.data.total
          && request.resource.data.streak >= 0
          && request.resource.data.streak <= request.resource.data.ok;
        allow delete: if isOwner(sid);
      }

      // Quiz ao vivo. quiz/state: só o professor escreve; todos leem (cada aluno escuta só este documento).
      match /quiz/{doc} {
        allow read: if signedIn();
        allow write: if isOwner(sid);
      }

      // Respostas do quiz, id = "<índice da pergunta>_<uid>". Só criação (ninguém responde duas
      // vezes), só antes da revelação e só para a pergunta em andamento.
      // O aluno lê apenas a própria resposta; o professor lê todas.
      match /quizAnswers/{id} {
        allow get: if signedIn() && (isOwner(sid) || id.matches('^[0-9]+_' + request.auth.uid + '$'));
        allow list: if isOwner(sid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'ms'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int
          && id == string(request.resource.data.q) + '_' + request.auth.uid
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 5
          && request.resource.data.ms is int
          && request.resource.data.ms >= 0 && request.resource.data.ms <= 120000
          && get(/databases/$(database)/documents/sessions/$(sid)/quiz/state).data.revealed == false
          && get(/databases/$(database)/documents/sessions/$(sid)/quiz/state).data.questionIndex == request.resource.data.q;
        allow update: if false;
        allow delete: if isOwner(sid);
      }

      // Desafio de diagnóstico ("rede quebrada"): id = "<rodada>_<uid>", só criação, só com a
      // rodada ativa. O gabarito não fica no banco (o professor o guarda no próprio navegador).
      match /diagAnswers/{id} {
        allow get: if signedIn() && (isOwner(sid) || id.matches('^[0-9]+_' + request.auth.uid + '$'));
        allow list: if isOwner(sid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'round', 'choice', 'cmds'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.round is int
          && id == string(request.resource.data.round) + '_' + request.auth.uid
          && request.resource.data.choice in ['dns', 'gateway', 'provedor', 'cabo']
          && request.resource.data.cmds is int
          && request.resource.data.cmds >= 0 && request.resource.data.cmds <= 999
          && get(/databases/$(database)/documents/sessions/$(sid)).data.diag.ativo == true
          && get(/databases/$(database)/documents/sessions/$(sid)).data.diag.rodada == request.resource.data.round;
        allow update: if false;
        allow delete: if isOwner(sid);
      }

      // Contador de IPs (alocação por transação).
      match /meta/{doc} {
        allow read, write: if signedIn();
        allow delete: if isOwner(sid);
      }
    }
  }
}
