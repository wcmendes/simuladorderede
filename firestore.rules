rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Só o professor dono da sessão (ownerUid) passa neste teste.
    function isOwner(sid) {
      return signedIn() &&
        get(/databases/$(database)/documents/sessions/$(sid)).data.ownerUid == request.auth.uid;
    }

    match /sessions/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Identidade da máquina: criada uma vez pelo próprio aluno; o IP não muda depois.
      match /hosts/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.ip == resource.data.ip;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      // Batimento (lastSeen). Fica separado de hosts para não gastar leituras da turma inteira.
      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      match /sites/{siteName} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner(sid));
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.fromIp ==
            get(/databases/$(database)/documents/sessions/$(sid)/hosts/$(request.auth.uid)).data.ip;
        allow update: if false;
        // Delete só para o professor, para o botão "Encerrar sessão" limpar tudo.
        allow delete: if isOwner(sid);
      }

      match /answers/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(sid));
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(sid));
      }

      // Contador de IPs (alocação por transação).
      match /meta/{doc} {
        allow read, write: if signedIn();
        allow delete: if isOwner(sid);
      }
    }
  }
}
